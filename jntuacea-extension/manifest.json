{
  "manifest_version": 3,
  "name": "JNTUACEA Attendance Helper",
  "version": "1.0",
  "description": "Official JNTUACEA portal lo login cheyagane - Reading your semester -> Overall % + Subject-wise % automatic ga chupistundi. CAPTCHA meeku normal ga solve cheyali, data mee browser lone vastundi.",
  "icons": {
    "128": "icons/icon-128.png",
    "192": "icons/icon-192.png",
    "512": "icons/icon-512.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://jntuaceastudents.classattendance.in/*",
        "*://jntuacea.classattendance.in/*",
        "*://ekr.classattendance.in/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["extractor.js"],
      "matches": ["*://*.classattendance.in/*"]
    }
  ]
}
